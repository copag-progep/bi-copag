# AnalyticSEI — ambiente local seguro
#
# Copie este arquivo para .env.local quando quiser rodar a API localmente:
#   cp .env.local.example .env.local
#
# Importante: não use DATABASE_URL da produção aqui. Sem DATABASE_URL, o projeto
# já usa SQLite local. A linha abaixo fixa um banco local separado e descartável.

DATABASE_URL=sqlite:///backend/data/analyticsei-local.db

JWT_SECRET_KEY=dev-local-troque-se-quiser
ACCESS_TOKEN_EXPIRE_MINUTES=720

DEFAULT_ADMIN_NAME=Administrador Local
DEFAULT_ADMIN_EMAIL=admin.local@ufc.br
DEFAULT_ADMIN_PASSWORD=admin123

API_UPLOAD_KEY=dev-upload-key
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Em ambiente local, manter true facilita ter dados de demonstração se houver
# CSVs de sample/workspace disponíveis no projeto.
AUTO_IMPORT_SAMPLE_DATA=true

# Desenvolvimento local: evita custo/latência de pré-aquecer todos os dashboards
# a cada restart da API.
DISABLE_STARTUP_PRECOMPUTE=true
ANALYTICS_LOOKBACK_DAYS=120
PRECOMPUTE_COOLDOWN_SECS=120
