# AnalyticSEI — variáveis de ambiente (backend Render)
#
# Copie este arquivo e preencha os valores reais no painel do Render.
# Nunca versione o .env com valores reais.

# String de conexão PostgreSQL (Aiven ou qualquer Postgres compatível).
# Sem esta variável, o backend usa SQLite local automaticamente.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require&channel_binding=require

JWT_SECRET_KEY=troque-por-uma-chave-forte
ACCESS_TOKEN_EXPIRE_MINUTES=720

# Admin criado automaticamente no primeiro boot (se não existir).
DEFAULT_ADMIN_NAME=Anderson CFS
DEFAULT_ADMIN_EMAIL=andersoncfs@ufc.br
DEFAULT_ADMIN_PASSWORD=admin123

# Chave usada pelo sei_uploader.py para uploads automáticos (sem JWT).
API_UPLOAD_KEY=troque-por-chave-aleatoria

# Origens permitidas no CORS (separadas por vírgula).
CORS_ORIGINS=https://analyticsei.vercel.app

# false em produção; true importa CSVs de sample do repositório no boot.
AUTO_IMPORT_SAMPLE_DATA=false

# No Render, mantenha false para não repetir migrations, create_all e índices
# em todo cold start. Ative temporariamente somente em deploys com novo schema.
RUN_DB_MAINTENANCE_ON_STARTUP=false
SQLALCHEMY_CONNECT_TIMEOUT=10
SQLALCHEMY_STATEMENT_TIMEOUT_MS=30000
SQLALCHEMY_LOCK_TIMEOUT_MS=5000

# Janela máxima de histórico analítico em dias (0 = sem limite).
ANALYTICS_LOOKBACK_DAYS=120

# false em produção; true desliga o aquecimento de cache no boot.
DISABLE_STARTUP_PRECOMPUTE=false

# Intervalo mínimo entre precomputes consecutivos (segundos).
PRECOMPUTE_COOLDOWN_SECS=120

SQLALCHEMY_POOL_RECYCLE=300

# ── Automações de e-mail (GitHub Actions) ────────────────────────────────────
# Conta Gmail usada para envio de relatórios e alertas automáticos.
GMAIL_USER=sua-conta@gmail.com
GMAIL_APP_PASSWORD=xxxx-xxxx-xxxx-xxxx

# Destinatários dos relatórios (separados por vírgula).
REPORT_RECIPIENTS=destinatario@ufc.br

# ── Uploader SEI (GitHub Actions) ────────────────────────────────────────────
SEI_URL=https://sei.ufc.br
SEI_USER=login.sei
SEI_PASSWORD=senha-sei

# URL da API para os scripts de automação (sem barra final).
BI_API_URL=https://bi-copag-api.onrender.com
BI_API_KEY=mesma-chave-do-API_UPLOAD_KEY
