# AnalyticSEI — frontend local
#
# Copie este arquivo para frontend/.env.local se quiser rodar o frontend
# diretamente de dentro da pasta frontend.
#
# Por padrão, o frontend usa "/api" e o Vite redireciona para o backend local.

VITE_PROXY_TARGET=http://127.0.0.1:8000

# Alternativa: descomente se quiser bypassar o proxy do Vite.
# VITE_API_URL=http://127.0.0.1:8000/api
